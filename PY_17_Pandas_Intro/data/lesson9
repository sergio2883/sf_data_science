# Конвертируем starttime и stoptime в datetime
df['starttime'] = pd.to_datetime(df['starttime'])
df['stoptime'] = pd.to_datetime(df['stoptime'])

# Создаём признак длительности поездки (в секундах)
df['trip_duration'] = (df['stoptime'] - df['starttime']).dt.total_seconds()

# Находим длительность поездки под индексом 3
duration_seconds = df.loc[3, 'trip_duration']
duration_minutes = int(duration_seconds // 60)  # целое количество минут

print(f"Длительность поездки под индексом 3:")
print(f"  В секундах: {duration_seconds}")
print(f"  В целых минутах: {duration_minutes}")

print(f"\nОтвет: {duration_minutes} минут(ы)")

# Конвертируем starttime в datetime
df['starttime'] = pd.to_datetime(df['starttime'])

# Создаём признак weekend (1 - выходной, 0 - будни)
# dayofweek: Monday=0, Tuesday=1, Wednesday=2, Thursday=3, Friday=4, Saturday=5, Sunday=6
df['weekend'] = df['starttime'].dt.dayofweek.isin([5, 6]).astype(int)

# Считаем количество поездок в выходные
weekend_rides = df['weekend'].sum()

print(f"Количество поездок, начавшихся в выходные: {weekend_rides}")
print(f"Всего поездок: {len(df)}")
print(f"Доля выходных поездок: {weekend_rides / len(df) * 100:.1f}%")

# Извлекаем час начала поездки
df['hour'] = df['starttime'].dt.hour

# Создаём признак time_of_day
def get_time_of_day(hour):
    if 0 <= hour <= 6:
        return 'night'
    elif 6 < hour <= 12:
        return 'morning'
    elif 12 < hour <= 18:
        return 'day'
    elif 18 < hour <= 23:
        return 'evening'
    else:
        return 'unknown'  # на случай некорректных данных

df['time_of_day'] = df['hour'].apply(get_time_of_day)

# Считаем количество поездок для каждого времени суток
time_counts = df['time_of_day'].value_counts()

print("Количество поездок по времени суток:")
print(time_counts)

# Получаем количество дневных и ночных поездок
day_rides = time_counts.get('day', 0)
night_rides = time_counts.get('night', 0)

# Вычисляем, во сколько раз дневных больше
if night_rides > 0:
    ratio = day_rides / night_rides
else:
    ratio = float('inf')

# Округляем до целых
ratio_rounded = round(ratio)

print(f"\nДневных поездок: {day_rides}")
print(f"Ночных поездок: {night_rides}")
print(f"Во сколько раз дневных больше: {ratio:.2f}")
print(f"Ответ (округлённый до целых): {ratio_rounded}")