import pandas as pd

# Загружаем объединённую таблицу
movies = pd.read_csv(r'D:\IDE\github\sf_data_science\PY_19_Pandas_Advance\data\ratings_movies.csv', sep=',')

# Проверяем, есть ли столбец с датой оценки
print("Столбцы в таблице:")
print(movies.columns.tolist())
print()

# Если есть столбец timestamp, преобразуем его в год
if 'timestamp' in movies.columns:
    movies['year_rating'] = pd.to_datetime(movies['timestamp'], unit='s').dt.year
elif 'date' in movies.columns:
    movies['year_rating'] = pd.to_datetime(movies['date']).dt.year
else:
    print("Столбец с датой не найден. Проверьте названия столбцов.")
    # Можно также поискать любой столбец, содержащий 'date' или 'time'
    date_cols = [col for col in movies.columns if 'date' in col.lower() or 'time' in col.lower()]
    if date_cols:
        print(f"Возможные столбцы с датой: {date_cols}")
        movies['year_rating'] = pd.to_datetime(movies[date_cols[0]]).dt.year
    else:
        raise KeyError("Не найден столбец с датой оценки")

# Создаём сводную таблицу
pivot_table = movies.pivot_table(
    values='rating',
    index='year_rating',
    columns='genres',
    aggfunc='mean'
)

print("Сводная таблица (фрагмент):")
print(pivot_table.iloc[:5, :5])
print()

# Проверяем каждое утверждение
print("=== ПРОВЕРКА УТВЕРЖДЕНИЙ ===\n")

# A: За весь период (1996-2018) жанр Action|Adventure ни разу не получал среднюю оценку ниже 3
genre_a = 'Action|Adventure'
if genre_a in pivot_table.columns:
    min_rating_a = pivot_table[genre_a].min()
    result_a = min_rating_a >= 3
    print(f"A: {genre_a} - минимальная средняя оценка = {min_rating_a:.2f} (ниже 3: {min_rating_a < 3})")
    print(f"   Утверждение A: {'ВЕРНО' if result_a else 'НЕВЕРНО'}")
else:
    print(f"A: Жанр '{genre_a}' не найден в данных")
    result_a = False
print()

# B: Наилучшую оценку жанр Action|Adventure|Animation|Children|Comedy|IMAX получил в 2010 году
genre_b = 'Action|Adventure|Animation|Children|Comedy|IMAX'
if genre_b in pivot_table.columns:
    best_year_b = pivot_table[genre_b].idxmax()
    best_rating_b = pivot_table[genre_b].max()
    result_b = best_year_b == 2010
    print(f"B: {genre_b} - лучшая оценка = {best_rating_b:.2f} в {best_year_b} году")
    print(f"   Утверждение B: {'ВЕРНО' if result_b else 'НЕВЕРНО'}")
else:
    print(f"B: Жанр '{genre_b}' не найден в данных")
    result_b = False
print()

# C: Среди сочетаний жанров, получивших наивысшую среднюю оценку в 2018 году, есть сочетание Animation|Children|Mystery
year_c = 2018
if year_c in pivot_table.index:
    # Находим максимальную среднюю оценку в 2018 году
    max_rating_c = pivot_table.loc[year_c].max()
    genres_with_max_c = pivot_table.loc[year_c][pivot_table.loc[year_c] == max_rating_c].index.tolist()
    genre_c = 'Animation|Children|Mystery'
    result_c = genre_c in genres_with_max_c
    print(f"C: В {year_c} году максимальная средняя оценка = {max_rating_c:.2f}")
    print(f"   Жанры с максимальной оценкой: {genres_with_max_c}")
    print(f"   Жанр '{genre_c}' в списке: {result_c}")
    print(f"   Утверждение C: {'ВЕРНО' if result_c else 'НЕВЕРНО'}")
else:
    print(f"C: Год {year_c} не найден в данных")
    result_c = False
print()

# D: Для жанра Comedy прослеживается тенденция падения рейтинга с каждым годом (1996-2018)
genre_d = 'Comedy'
if genre_d in pivot_table.columns:
    comedy_ratings = pivot_table[genre_d].dropna()
    # Проверяем, что рейтинг падает с каждым годом
    is_decreasing = all(comedy_ratings.iloc[i] >= comedy_ratings.iloc[i+1] 
                        for i in range(len(comedy_ratings)-1))
    print(f"D: Жанр '{genre_d}' - изменение рейтинга по годам:")
    for year, rating in comedy_ratings.items():
        print(f"   {year}: {rating:.2f}")
    print(f"   Тенденция падения: {is_decreasing}")
    print(f"   Утверждение D: {'ВЕРНО' if is_decreasing else 'НЕВЕРНО'}")
else:
    print(f"D: Жанр '{genre_d}' не найден в данных")
    result_d = False
print()

# Выводим итоговый ответ
print("\n=== ВЕРНЫЕ УТВЕРЖДЕНИЯ ===")
if result_a:
    print("A")
if result_b:
    print("B")
if result_c:
    print("C")
if result_d:
    print("D")


