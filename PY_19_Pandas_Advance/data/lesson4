# Приведение к числовому типу (на всякий случай)
merged = pd.merge(purchase_df, items_df, on='item_id', how='inner')

# Сортируем ТОЛЬКО по purchase_id, сохраняя исходный порядок item_id внутри группы
merged = merged.sort_values('purchase_id').reset_index(drop=True)

merged = merged[['item_id', 'vendor', 'stock_count', 'purchase_id', 'price']]

print(merged)

# Теперь считаем выручку (для второго пункта задания)
# Берём уникальные item_id, так как иначе товары с несколькими покупками учтутся несколько раз
income = (merged.drop_duplicates('item_id')['stock_count'] * 
          merged.drop_duplicates('item_id')['price']).sum()

print(f"\nincome = {income}")
