pivot_table = df.pivot_table(values='Price', 
                              index='SellerG', 
                              columns='Type', 
                              aggfunc='median')

print("Сводная таблица (медианная цена по агентствам и типам):")
print(pivot_table)
print()

# Проверяем, есть ли колонка 'u' (unit)
if 'unit' in pivot_table.columns:
    # Находим агентство с максимальной медианной ценой для типа 'u' (unit)
    # Убираем NaN значения (агентства, у которых нет продаж типа unit)
    unit_prices = pivot_table['unit'].dropna()
    
    if len(unit_prices) > 0:
        max_agency = unit_prices.idxmax()
        max_price = unit_prices.max()
        
        print(f"=== РЕЗУЛЬТАТ ===")
        print(f"Агентство с максимальной медианной ценой для типа unit: {max_agency}")
        print(f"Медианная цена: {max_price:.2f}")
        
        print(f"\nОтвет: {max_agency}")
    else:
        print("Нет данных по типу 'unit'")
else:
    print("Колонка 'u' (unit) не найдена в данных")
    print(f"Доступные типы: {pivot_table.columns.tolist()}")