import pandas as pd
orders = pd.read_csv(r'D:\IDE\github\sf_data_science\PY_19_Pandas_Advance\data\orders.csv', sep=';')
products = pd.read_csv(r'D:\IDE\github\sf_data_science\PY_19_Pandas_Advance\data\products.csv', sep=';')

merged = pd.merge(orders, products, left_on='ID товара', right_on='Product_ID', how='left')

# Объединяем по ключу 'ID товара' (orders) = 'Product_ID' (products)
orders_products = pd.merge(orders,
                           products,
                           left_on='ID товара',
                           right_on='Product_ID',
                           how='left').drop('Product_ID', axis=1)

# Проверяем результат
print(orders_products.head())

order_id = merged.loc[merged['Product_ID'].isna(), 'Order ID'].values[0]
print(order_id)

# Фильтруем отменённые заказы
canceled = merged[merged['Отменен'] == 'Да']

# Выводим название товара(ов) по отменённым заказам
print(canceled[['Order ID', 'ID товара', 'Name', 'Отменен']])

# Отбираем оплаченные заказы (Оплачен = Да)
paid = merged[merged['Оплачен'] == 'Да'].copy()

# Рассчитываем прибыль по каждой строке заказа
paid['profit'] = paid['Количество'] * paid['Price']

# Группируем по покупателю и суммируем прибыль
customer_profit = paid.groupby('ID Покупателя')['profit'].sum().sort_values(ascending=False)

# Выводим топ покупателей
print(customer_profit.head(10))

# Ответ: покупатель с максимальной прибылью
top_customer = customer_profit.idxmax()
print(f"\nОтвет: {top_customer}")